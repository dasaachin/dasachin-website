{
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": "dist",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/about-me",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/publications",
      "destination": "/books",
      "permanent": true
    },
    {
      "source": "/category/:c*",
      "destination": "/blog",
      "permanent": false
    },
    {
      "source": "/page/:n",
      "destination": "/blog",
      "permanent": false
    },
    {
      "source": "/blog/medium/:slug",
      "destination": "/blog",
      "permanent": false
    }
  ]
}
